{
  "name": "ocr",
  "description": "OCR 图片文字识别（PP-OCRv6 + ncnn，中英日多语，支持 URL / base64）",
  "type": "python",
  "entry": "server.py",
  "deps": "requirements.txt",
  "port": 18699,
  "version": "1.0.0",
  "config": {
    "max_body_mb": {
      "label": "请求体上限（MB，base64 图片）",
      "type": "number",
      "default": "12",
      "env": "MAX_BODY_MB"
    },
    "ocr_threads": {
      "label": "推理线程数（1-8）",
      "type": "number",
      "default": "2",
      "env": "OCR_THREADS"
    }
  }
}
